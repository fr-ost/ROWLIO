{
  "name": "rowlio",
  "version": "1.1.0",
  "private": true,
  "description": "Rowlio: Free Web Scraper & Data Extractor. Turn any webpage into structured data.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/licenses.mjs && node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --e2e",
    "icons": "node scripts/generate-icons.mjs",
    "licenses": "node scripts/licenses.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && npm run build:e2e && playwright test --trace off",
    "verify": "npm run typecheck && npm run test && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs",
    "screenshots": "npm run build:e2e && ROWLIO_SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts --trace off",
    "website": "node scripts/website.mjs",
    "website:preview": "node scripts/website.mjs --serve"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "read-excel-file": "^9.3.14",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
